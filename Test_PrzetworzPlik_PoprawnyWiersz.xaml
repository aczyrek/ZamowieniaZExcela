<Activity mc:Ignorable="sap sap2010" x:Class="Test_PrzetworzPlik_PoprawnyWiersz" mva:VisualBasic.Settings="{x:Null}" sap2010:WorkflowViewState.IdRef="ActivityBuilder_1"
xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=mscorlib"
xmlns:ui="http://schemas.uipath.com/workflow/activities"
xmlns:uic="clr-namespace:UiPath.Core.Activities;assembly=UiPath.System.Activities"
xmlns:ut="clr-namespace:UiPath.Testing.Activities;assembly=UiPath.Testing.Activities"
xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.IO</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Testing.Activities</AssemblyReference>
      <AssemblyReference>System.Data.DataSetExtensions</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Test — poprawny wiersz trafia do SAP" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="strPlikTemp" Default="[Path.Combine(Path.GetTempPath(), &quot;TST_happy_&quot; &amp; Now.Ticks.ToString &amp; &quot;.xlsx&quot;)]" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtPliki" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtKolumny" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="dictIndeksy" Default="[New Dictionary(Of String, String)()]" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Boolean)" Name="dictPrzetworzone" Default="[New Dictionary(Of String, Boolean)()]" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtSapWzor" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtBledyWzor" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtDane" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtSapPlik" />
      <Variable x:TypeArguments="sd:DataTable" Name="dtBledyPlik" />
      <Variable x:TypeArguments="x:String" Name="strKlient" />
    </Sequence.Variables>

    <!-- ARRANGE -->
    <ui:GenerateDataTable ColumnSeparators="{x:Null}" ColumnSizes="{x:Null}" NewLineSeparator="{x:Null}" Positions="{x:Null}" AutoDetectTypes="False" CSVParsing="True" DataTable="[dtPliki]" DisplayName="Arrange - konfiguracja pliki" sap2010:WorkflowViewState.IdRef="GenerateDataTable_1" Input="[&quot;PrefiksPliku,Klient,Arkusz,KomorkaStart&quot;]" UseColumnHeader="True" />
    <uic:AddDataRow DisplayName="Arrange - klient testowy" sap2010:WorkflowViewState.IdRef="AddDataRow_1">
      <uic:AddDataRow.DataTable><InOutArgument x:TypeArguments="sd:DataTable">[dtPliki]</InOutArgument></uic:AddDataRow.DataTable>
      <uic:AddDataRow.ArrayRow><InArgument x:TypeArguments="s:Object[]">[New Object() {"TST", "Testowy", "Dane", "A1"}]</InArgument></uic:AddDataRow.ArrayRow>
    </uic:AddDataRow>

    <ui:GenerateDataTable ColumnSeparators="{x:Null}" ColumnSizes="{x:Null}" NewLineSeparator="{x:Null}" Positions="{x:Null}" AutoDetectTypes="False" CSVParsing="True" DataTable="[dtKolumny]" DisplayName="Arrange - konfiguracja kolumny" sap2010:WorkflowViewState.IdRef="GenerateDataTable_2" Input="[&quot;Klient,KolumnaKlienta,PoleWspolne&quot;]" UseColumnHeader="True" />
    <uic:AddDataRow DisplayName="Arrange - kolumna NrZamowienia" sap2010:WorkflowViewState.IdRef="AddDataRow_2">
      <uic:AddDataRow.DataTable><InOutArgument x:TypeArguments="sd:DataTable">[dtKolumny]</InOutArgument></uic:AddDataRow.DataTable>
      <uic:AddDataRow.ArrayRow><InArgument x:TypeArguments="s:Object[]">[New Object() {"Testowy", "NrZamowienia", "NrZamowienia"}]</InArgument></uic:AddDataRow.ArrayRow>
    </uic:AddDataRow>
    <uic:AddDataRow DisplayName="Arrange - kolumna IndeksKlienta" sap2010:WorkflowViewState.IdRef="AddDataRow_3">
      <uic:AddDataRow.DataTable><InOutArgument x:TypeArguments="sd:DataTable">[dtKolumny]</InOutArgument></uic:AddDataRow.DataTable>
      <uic:AddDataRow.ArrayRow><InArgument x:TypeArguments="s:Object[]">[New Object() {"Testowy", "IndeksKlienta", "IndeksKlienta"}]</InArgument></uic:AddDataRow.ArrayRow>
    </uic:AddDataRow>
    <uic:AddDataRow DisplayName="Arrange - kolumna Ilosc" sap2010:WorkflowViewState.IdRef="AddDataRow_4">
      <uic:AddDataRow.DataTable><InOutArgument x:TypeArguments="sd:DataTable">[dtKolumny]</InOutArgument></uic:AddDataRow.DataTable>
      <uic:AddDataRow.ArrayRow><InArgument x:TypeArguments="s:Object[]">[New Object() {"Testowy", "Ilosc", "Ilosc"}]</InArgument></uic:AddDataRow.ArrayRow>
    </uic:AddDataRow>
    <uic:AddDataRow DisplayName="Arrange - kolumna DataDostawy" sap2010:WorkflowViewState.IdRef="AddDataRow_5">
      <uic:AddDataRow.DataTable><InOutArgument x:TypeArguments="sd:DataTable">[dtKolumny]</InOutArgument></uic:AddDataRow.DataTable>
      <uic:AddDataRow.ArrayRow><InArgument x:TypeArguments="s:Object[]">[New Object() {"Testowy", "DataDostawy", "DataDostawy"}]</InArgument></uic:AddDataRow.ArrayRow>
    </uic:AddDataRow>

    <Assign DisplayName="Arrange - indeks TST IDX-001" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To><OutArgument x:TypeArguments="x:String">[dictIndeksy("Testowy|IDX-001")]</OutArgument></Assign.To>
      <Assign.Value><InArgument x:TypeArguments="x:String">["SAP-TEST-001"]</InArgument></Assign.Value>
    </Assign>

    <ui:GenerateDataTable ColumnSeparators="{x:Null}" ColumnSizes="{x:Null}" NewLineSeparator="{x:Null}" Positions="{x:Null}" AutoDetectTypes="False" CSVParsing="True" DataTable="[dtSapWzor]" DisplayName="Arrange - wzór tabeli SAP" sap2010:WorkflowViewState.IdRef="GenerateDataTable_3" Input="[&quot;NrZamowienia,Klient,IndeksKlienta,IndeksWewnetrzny,Ilosc,DataDostawy,PlikZrodlowy&quot;]" UseColumnHeader="True" />
    <ui:GenerateDataTable ColumnSeparators="{x:Null}" ColumnSizes="{x:Null}" NewLineSeparator="{x:Null}" Positions="{x:Null}" AutoDetectTypes="False" CSVParsing="True" DataTable="[dtBledyWzor]" DisplayName="Arrange - wzór tabeli błędów" sap2010:WorkflowViewState.IdRef="GenerateDataTable_4" Input="[&quot;PlikZrodlowy,Klient,NrZamowienia,IndeksKlienta,Ilosc,Powod&quot;]" UseColumnHeader="True" />

    <ui:GenerateDataTable ColumnSeparators="{x:Null}" ColumnSizes="{x:Null}" NewLineSeparator="{x:Null}" Positions="{x:Null}" AutoDetectTypes="False" CSVParsing="True" DataTable="[dtDane]" DisplayName="Arrange - dane wejściowe" sap2010:WorkflowViewState.IdRef="GenerateDataTable_5" Input="[&quot;NrZamowienia,IndeksKlienta,Ilosc,DataDostawy&quot;]" UseColumnHeader="True" />
    <uic:AddDataRow DisplayName="Arrange - 1 poprawny wiersz" sap2010:WorkflowViewState.IdRef="AddDataRow_6">
      <uic:AddDataRow.DataTable><InOutArgument x:TypeArguments="sd:DataTable">[dtDane]</InOutArgument></uic:AddDataRow.DataTable>
      <uic:AddDataRow.ArrayRow><InArgument x:TypeArguments="s:Object[]">[New Object() {"T-001", "IDX-001", "5", "2026-12-31"}]</InArgument></uic:AddDataRow.ArrayRow>
    </uic:AddDataRow>

    <ui:WriteRange DataTable="[dtDane]" DisplayName="Arrange - zapisz plik testowy" sap2010:WorkflowViewState.IdRef="WriteRange_1" SheetName="Dane" StartingCell="A1" WorkbookPath="[strPlikTemp]" AddHeaders="True" />

    <!-- ACT -->
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Act - PrzetworzPlik" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="PrzetworzPlik.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="in_SciezkaPliku">[strPlikTemp]</InArgument>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtPliki">[dtPliki]</InArgument>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtKolumny">[dtKolumny]</InArgument>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="in_dictIndeksy">[dictIndeksy]</InArgument>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Boolean)" x:Key="in_dictPrzetworzone">[dictPrzetworzone]</InArgument>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtSapWzor">[dtSapWzor]</InArgument>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="in_dtBledyWzor">[dtBledyWzor]</InArgument>
        <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_dtSapPlik">[dtSapPlik]</OutArgument>
        <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_dtBledyPlik">[dtBledyPlik]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_Klient">[strKlient]</OutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>

    <!-- ASSERT -->
    <ut:VerifyExpression DisplayName="Assert - 1 wiersz trafia do SAP" sap2010:WorkflowViewState.IdRef="VerifyExpression_1" ContinueOnFailure="False">
      <ut:VerifyExpression.Expression>
        <InArgument x:TypeArguments="x:Boolean">[dtSapPlik.Rows.Count = 1]</InArgument>
      </ut:VerifyExpression.Expression>
    </ut:VerifyExpression>
    <ut:VerifyExpression DisplayName="Assert - brak błędów" sap2010:WorkflowViewState.IdRef="VerifyExpression_2" ContinueOnFailure="False">
      <ut:VerifyExpression.Expression>
        <InArgument x:TypeArguments="x:Boolean">[dtBledyPlik.Rows.Count = 0]</InArgument>
      </ut:VerifyExpression.Expression>
    </ut:VerifyExpression>
    <ut:VerifyExpression DisplayName="Assert - IndeksWewnetrzny = SAP-TEST-001" sap2010:WorkflowViewState.IdRef="VerifyExpression_3" ContinueOnFailure="False">
      <ut:VerifyExpression.Expression>
        <InArgument x:TypeArguments="x:Boolean">[dtSapPlik.Rows(0)("IndeksWewnetrzny").ToString = "SAP-TEST-001"]</InArgument>
      </ut:VerifyExpression.Expression>
    </ut:VerifyExpression>
    <ut:VerifyExpression DisplayName="Assert - klient = Testowy" sap2010:WorkflowViewState.IdRef="VerifyExpression_4" ContinueOnFailure="False">
      <ut:VerifyExpression.Expression>
        <InArgument x:TypeArguments="x:Boolean">[strKlient = "Testowy"]</InArgument>
      </ut:VerifyExpression.Expression>
    </ut:VerifyExpression>
  </Sequence>
</Activity>
