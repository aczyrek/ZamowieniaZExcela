    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[dtMapowanie]" DisplayName="Słownik indeksów (Klient|Indeks)" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
